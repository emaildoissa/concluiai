# ==========================================
# Concluí AI — Comprehensive .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!**/.env.example

# Security & Credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
*.pub

# Dependencies
node_modules/
.pnpm-store/
.npm
.yarn/
.yarn-cache

# Build & Output files
dist/
build/
out/
.next/
.turbo/
.cache/
coverage/
*.tsbuildinfo

# Expo / React Native / Mobile
.expo/
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/web-build/
*.apk
*.aab
*.ipa

# Docker & Deployment temporary files
*.tar
*.tar.gz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editors
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.zed/

