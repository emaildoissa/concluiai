# =============================================================================
# Concluí AI — variáveis de ambiente (copie para .env e preencha)
# =============================================================================

# ---- Supabase (público) ------------------------------------------------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...anon

# ---- Vite (apps/web) — mesmo projeto, prefixo VITE_ ----------------------
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon
# VITE_API_URL=http://192.168.x.x:4000  # opcional; vazio usa o proxy do Vite
# Em produção (Vercel) aponte para a API publicada:
# VITE_API_URL=https://concluiai-api.automacao.free.nf

# ---- API Node (service role — NUNCA exponha no app) ---------------------
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
API_KEY=uma-chave-secreta-para-o-endpoint-de-analise

# ---- Google Gemini ------------------------------------------------------
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ---- Score P/E/Q (opcional) ----------------------------------------------
# SCORE_WEIGHT_P=0.35
# SCORE_WEIGHT_E=0.30
# SCORE_WEIGHT_Q=0.35
# SCORE_CRITICAL_MULTIPLIER=1.5

# ---- Jobs (opcional) ------------------------------------------------------
# ALERT_CHECK_INTERVAL_MS=60000
# SCORE_RECALC_INTERVAL_MS=300000

# ---- WhatsApp — alertas críticos (opcional; mock por padrão) --------------
# WHATSAPP_PROVIDER=mock  # meta | evolution | twilio | mock
# WHATSAPP_API_URL=https://evolution.automacao.free.nf
# WHATSAPP_TOKEN=apikey-da-instancia
# WHATSAPP_INSTANCE=nome-da-instancia  # Evolution: nome exato da instância
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=concluiai_webhook_verify
