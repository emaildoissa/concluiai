# Copie para .env e preencha com seus valores reais.
# Veja o .env.example na raiz do projeto para a descrição de cada variável.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
API_KEY=
PORT=4000

# WhatsApp — alertas críticos (opcional; mock por padrão)
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=https://evolution.automacao.free.nf
WHATSAPP_TOKEN=
WHATSAPP_INSTANCE=
# Número do robô (o mesmo da instância) — usado para bloquear auto-envio
WHATSAPP_INSTANCE_NUMBER=

# Cron diário de geração de tarefas (desligue com CRON_DAILY_GENERATE=0)
CRON_DAILY_GENERATE=1
CRON_DAILY_GENERATE_CRON=0 5 * * *
CRON_DAILY_GENERATE_TZ=America/Sao_Paulo

# Limpeza de evidências antigas (desligue com CRON_EVIDENCE_CLEANUP=0)
# Apaga fotos > N dias do Storage e do feed (métricas ficam em daily_scores)
CRON_EVIDENCE_CLEANUP=1
CRON_EVIDENCE_CLEANUP_CRON=0 3 * * *
CRON_EVIDENCE_CLEANUP_TZ=America/Sao_Paulo
EVIDENCE_RETENTION_DAYS=30
